# Database (Inserisci la tua connessione PostgreSQL — es. Neon)
DATABASE_URL=jdbc:postgresql://host/db?user=user&password=pass&sslmode=require

# Frontend (separato da virgole se multipli)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email SMTP (Gmail con App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=la.tua.email@gmail.com
MAIL_PASSWORD=la-tua-app-password
